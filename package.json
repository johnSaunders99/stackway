    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.4.1",
    "fake-indexeddb": "6.0.0",
    "highlight.js": "11.11.1",
    "markdown-it": "14.1.0",
    "typescript": "5.8.3",
    "vite": "6.1.6",
